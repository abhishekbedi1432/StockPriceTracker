{
  "sourceLanguage": "en",
  "strings": {
    "About": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نبذة"
          }
        }
      }
    },
    "Adobe develops software for creative work, documents, and digital experiences.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تطور Adobe برمجيات للعمل الإبداعي والمستندات والتجارب الرقمية."
          }
        }
      }
    },
    "Alibaba provides commerce platforms and cloud computing services.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توفر Alibaba منصات للتجارة وخدمات الحوسبة السحابية."
          }
        }
      }
    },
    "Alphabet develops internet search, advertising, and cloud services.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تطور Alphabet خدمات البحث على الإنترنت والإعلان والحوسبة السحابية."
          }
        }
      }
    },
    "Amazon operates online retail, logistics, and cloud computing services.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تدير Amazon تجارة التجزئة عبر الإنترنت والخدمات اللوجستية وخدمات الحوسبة السحابية."
          }
        }
      }
    },
    "AMD designs processors and graphics technology for computers and data centers.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصمم AMD معالجات وتقنيات رسوميات لأجهزة الكمبيوتر ومراكز البيانات."
          }
        }
      }
    },
    "Apple designs personal devices, software, and digital services.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصمم Apple أجهزة شخصية وبرامج وخدمات رقمية."
          }
        }
      }
    },
    "Block develops payment and financial technology products. This demo uses the historical SQ symbol.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تطور Block منتجات للدفع والتكنولوجيا المالية. يستخدم هذا العرض الرمز التاريخي SQ."
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلغاء"
          }
        }
      }
    },
    "Change since the previous update": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التغير منذ التحديث السابق"
          }
        }
      }
    },
    "Choose a symbol to see its latest price.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر رمزًا لعرض أحدث سعر له."
          }
        }
      }
    },
    "Choose another stock from the list.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر سهمًا آخر من القائمة."
          }
        }
      }
    },
    "Cisco develops networking, security, and collaboration technology.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تطور Cisco تقنيات الشبكات والأمن والتعاون."
          }
        }
      }
    },
    "Connected": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متصل"
          }
        }
      }
    },
    "Connecting…": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ الاتصال…"
          }
        }
      }
    },
    "Connection failed": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل الاتصال"
          }
        }
      }
    },
    "Disconnected": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غير متصل"
          }
        }
      }
    },
    "DocuSign provides electronic signature and agreement management software.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توفر DocuSign برمجيات للتوقيع الإلكتروني وإدارة الاتفاقيات."
          }
        }
      }
    },
    "IBM provides enterprise software, infrastructure, and consulting services.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توفر IBM برمجيات المؤسسات والبنية التحتية وخدمات الاستشارات."
          }
        }
      }
    },
    "Intel designs and manufactures processors and other semiconductor products.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصمم Intel وتصنع المعالجات ومنتجات أشباه الموصلات الأخرى."
          }
        }
      }
    },
    "Lyft operates a platform that connects riders with drivers.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تدير Lyft منصة تربط الركاب بالسائقين."
          }
        }
      }
    },
    "Meta develops social networking, messaging, and virtual reality products.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تطور Meta منتجات التواصل الاجتماعي والمراسلة والواقع الافتراضي."
          }
        }
      }
    },
    "Microsoft develops productivity software, cloud services, and computing platforms.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تطور Microsoft برامج الإنتاجية والخدمات السحابية ومنصات الحوسبة."
          }
        }
      }
    },
    "Netflix provides streaming entertainment and produces films and series.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توفر Netflix ترفيهًا عبر البث وتنتج أفلامًا ومسلسلات."
          }
        }
      }
    },
    "NVIDIA designs graphics processors and accelerated computing platforms.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصمم NVIDIA معالجات رسوميات ومنصات حوسبة مسرّعة."
          }
        }
      }
    },
    "Oracle develops database software, business applications, and cloud services.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تطور Oracle برمجيات قواعد البيانات وتطبيقات الأعمال والخدمات السحابية."
          }
        }
      }
    },
    "Pinterest operates a visual discovery platform for ideas and inspiration.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تدير Pinterest منصة اكتشاف مرئي للأفكار والإلهام."
          }
        }
      }
    },
    "Price": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السعر"
          }
        }
      }
    },
    "Price Change": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغير السعر"
          }
        }
      }
    },
    "Price decreased": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انخفض السعر"
          }
        }
      }
    },
    "Price increased": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارتفع السعر"
          }
        }
      }
    },
    "Price unchanged": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتغير السعر"
          }
        }
      }
    },
    "Retry": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة المحاولة"
          }
        }
      }
    },
    "Salesforce provides cloud software for customer relationship management.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توفر Salesforce برمجيات سحابية لإدارة علاقات العملاء."
          }
        }
      }
    },
    "Select a stock": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر سهمًا"
          }
        }
      }
    },
    "Shopify provides software and services that help merchants sell online and in person.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توفر Shopify برمجيات وخدمات تساعد التجار على البيع عبر الإنترنت وشخصيًا."
          }
        }
      }
    },
    "Simulated prices": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أسعار محاكاة"
          }
        }
      }
    },
    "Snap develops Snapchat and camera-based communication products.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تطور Snap تطبيق Snapchat ومنتجات تواصل تعتمد على الكاميرا."
          }
        }
      }
    },
    "Sort by": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ترتيب حسب"
          }
        }
      }
    },
    "Start": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدء"
          }
        }
      }
    },
    "Stock unavailable": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السهم غير متاح"
          }
        }
      }
    },
    "Stock-price updates for %@.": {
      "comment": "Stock detail description. The placeholder is the company name.",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "تحديثات سعر سهم %@‏"
          }
        }
      }
    },
    "Stocks": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأسهم"
          }
        }
      }
    },
    "Stop": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيقاف"
          }
        }
      }
    },
    "Stopping…": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ الإيقاف…"
          }
        }
      }
    },
    "Tesla develops electric vehicles and energy storage products.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تطور Tesla مركبات كهربائية ومنتجات لتخزين الطاقة."
          }
        }
      }
    },
    "The feed stopped. Please try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقف تدفق الأسعار. يُرجى المحاولة مرة أخرى."
          }
        }
      }
    },
    "Twitter developed a social networking service. This demo uses its historical TWTR symbol.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طورت Twitter خدمة تواصل اجتماعي. يستخدم هذا العرض رمزها التاريخي TWTR."
          }
        }
      }
    },
    "Uber operates platforms for ride booking and delivery services.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تدير Uber منصات لحجز الرحلات وخدمات التوصيل."
          }
        }
      }
    },
    "Zoom provides video meetings and workplace communication software.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توفر Zoom برمجيات لاجتماعات الفيديو والتواصل في مكان العمل."
          }
        }
      }
    }
  },
  "version": "1.3"
}
